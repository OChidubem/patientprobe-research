# Public template: all credentials and telephone endpoints are deliberately blank.
# Only configure the following in your LOCAL .env, which must never be committed.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
SIP_FROM_NUMBER=
PATIENTPROBE_APPROVED_DESTINATION=

# Explicit safeguard; keep false unless you have authorization and consent.
PATIENTPROBE_ENABLE_LIVE_CALLS=false

# Third-party API keys
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Optional non-secret settings
PATIENTPROBE_LLM_MODEL=gpt-4.1-mini
PATIENTPROBE_TTS_MODEL=gpt-4o-mini-tts
PATIENTPROBE_TTS_VOICE=ash
PATIENTPROBE_MAX_SECONDS=175
PATIENTPROBE_ARTIFACTS=artifacts/calls
